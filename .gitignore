# Python
venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets — never commit
.env
.env.*
!.env.example
!monitoring/web/.env.example
!deploy/.env.example

# Data & reports output
backtest/reports/*.csv
backtest/reports/*.png
backtest/reports/presets/*/*.csv
backtest/reports/presets/*/*.png

# Paper trading state
db/*.db
db/*.db-wal
db/*.db-shm
paper_trading/logs/

# Node
node_modules/

# Backup lokal (off-disk backup lewat CI commit db/paper_trading.db)
db/backups/
.dump
.vercel

# Playwright auth storage state (regenerable — dibuat ulang test login e2e)
monitoring/web/e2e/.auth/
