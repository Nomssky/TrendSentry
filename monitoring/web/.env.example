# —— TrendSentry environment variables ———
# Copy to .env.local and fill in values.

# Supabase (project: trendsentry)
NEXT_PUBLIC_SUPABASE_URL=https://ypkdnvwlekxmmotxsvrm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_iqojFl0RG3DhO5XNz7EBng_WJWiTHBF

# Supabase service_role key (for admin operations like cron)
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM encryption key for API keys at rest (exactly 32 characters)
ENCRYPTION_KEY=

# Cron secret — must match CRON_SECRET in GitHub repo secrets & Vercel env
CRON_SECRET=

# Origin yang diizinkan untuk request mutasi (CSRF). Comma-separated.
# Kosong = default: https://trendsentry.vercel.app + localhost:3000/3001.
# Set ini kalau pakai domain kustom (mis. https://trendsentry.com).
ALLOWED_ORIGINS=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stripe (for premium tiers)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
