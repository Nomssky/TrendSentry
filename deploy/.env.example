# Salin ke .env (lokal) / secret store Coolify (VPS). JANGAN commit .env.
# Secret asli tidak pernah masuk repo — prosedur di RUNBOOK.md.

# --- Web (deploy sebagai build-arg NEXT_PUBLIC_* + env sisanya) ---
NEXT_PUBLIC_SUPABASE_URL=https://xyz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...          # server-only, JANGAN berawalan NEXT_PUBLIC_
ENCRYPTION_KEY=                                   # hasil: openssl rand -hex 32 (HARUS sama dgn cloud saat migrasi key user!)
CRON_SECRET=                                      # hasil: openssl rand -hex 32 (baru, khusus VPS)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STRIPE_SECRET_KEY=                                # kosong = checkout tetap gated 403
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ENABLED=

# --- Supabase self-hosted (Coolify one-click; nilai dirujuk, bukan ditulis ulang) ---
# GOTRUE_SITE_URL=https://trendsentry.com
# GOTRUE_SMTP_*=...                               # Brevo (sama seperti cloud hari ini)
# JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY          # generate sekali, simpan di password manager + backup .env
