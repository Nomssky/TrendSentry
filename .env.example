# Salin file ini ke .env dan isi dengan value asli. Jangan commit .env ke git.

# Exchange (Fase 4 - live execution)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_NAME=bitget           # bitget (paper trading), binance/bybit (alternatives)

# LLM Filter (Fase 3)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Monitoring
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database (Fase 4, kalau pakai Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/trading_bot

# Mode: backtest | paper | live
RUN_MODE=backtest
