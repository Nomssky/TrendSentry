# Salin file ini ke .env dan isi dengan value asli. Jangan commit .env ke git.

# Exchange (Fase 4 - live execution)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_NAME=bitget           # venue tunggal: bitget (paper trading + rencana live Fase 4)

# LLM Filter (Fase 3)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Monitoring
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database (Fase 4, kalau pakai Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/trading_bot

# Mode: backtest | paper | live
RUN_MODE=backtest

# Runtime deployment (Phase B) — paper_trading/run_deployment.py, self-hosted.
# Token baca config dibuat server dan tampil PERSIS SATU KALI di response
# POST /api/deployments; hash-nya saja yang tersimpan. Jangan commit nilai aslinya.
TREND_SENTRY_DEPLOYMENT_ID=
TREND_SENTRY_CONFIG_URL=
TREND_SENTRY_CONFIG_TOKEN=
